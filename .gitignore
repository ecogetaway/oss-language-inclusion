__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Build artifacts — regenerated by `python -m build` on every release.
# Committing them means `twine upload dist/*` picks up stale versions and
# fails on "file already exists". Build locally, upload the new version only.
dist/
build/

.venv/
tools/**/.venv/
.DS_Store

# --- working documents: never publish (managed) ---
# Engagement/outreach plans, funding proposals, cover notes and unpublished
# article drafts stay on disk but must never reach this public repo.
# If one ever truly belongs here: git add -f <path>
.DS_Store
~$*
*.docx
*.doc
*.pdf
**/outreach/
*ngagement-Plan*
*ngagement-plan*
/A11y/
